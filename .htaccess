DirectoryIndex index.php index.html

# Disable directory listing
Options -Indexes

# ---------------------------------------------------------------------------
# URL bersih & SEO. Alamat teknis lama (products.php?category=..., product-detail.php?slug=...)
# dialihkan 301 oleh PHP (is_legacy_url + redirect_clean di includes/config.php).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www -> tanpa www (satu alamat resmi)
    RewriteCond %{HTTP_HOST} ^www\.wintom\.co\.id$ [NC]
    RewriteRule ^ https://wintom.co.id%{REQUEST_URI} [R=301,L]

    # Halaman statis versi lama -> diteruskan ke PHP, yang mengalihkan 301 ke / dan /katalog
    RewriteRule ^index\.html$ index.php [L]
    RewriteRule ^products\.html$ products.php [L]

    # URL bersih -> skrip PHP
    RewriteRule ^produk/([^/]+)/?$ product-detail.php?slug=$1 [L,QSA]
    RewriteRule ^katalog/?$ products.php [L,QSA]
    RewriteRule ^katalog/([^/]+)/?$ products.php?category=$1 [L,QSA]
    RewriteRule ^galeri/?$ gallery.php [L,QSA]
    RewriteRule ^tentang/?$ about.php [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(md|sqlite|sqlite3|db|php-cs-fixer)$|^(package(-lock)?\.json|tailwind\.config\.js)$">
    Require all denied
</FilesMatch>

# Deny access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Cache untuk CDN Hostinger & browser
# File statis boleh di-cache lama oleh CDN (edge) dan browser. Halaman PHP tidak:
# PHP mengirim "Cache-Control: no-store" karena setiap halaman punya sesi + token
# CSRF form, jadi HTML selalu diambil segar dari server (status CDN: DYNAMIC).
# Ganti file di assets/ dengan nama yang sama? Purge cache CDN di hPanel.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Gambar, video, ikon, font di assets/: 30 hari
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|avif|mp4|webm|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # CSS/JS hasil build: dipanggil dengan ?v=<waktu ubah file>, jadi aman di-cache 1 tahun
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
